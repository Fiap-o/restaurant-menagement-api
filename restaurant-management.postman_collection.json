{
  "info": {
    "name": "Restaurant Management API",
    "description": "Coleção de testes para o Tech Challenge Fase 1 - Gestão de Usuários",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "usuarioId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Cadastro de Usuário",
      "item": [
        {
          "name": "Cadastro válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Retorna id do usuário\", function () {",
                  "    pm.expect(jsonData.id).to.not.be.undefined;",
                  "});",
                  "pm.test(\"Não retorna senha em texto puro\", function () {",
                  "    pm.expect(jsonData.senha).to.be.undefined;",
                  "});",
                  "",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"usuarioId\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Silva\",\n  \"email\": \"joao.silva@email.com\",\n  \"login\": \"joaosilva\",\n  \"senha\": \"senha123\",\n  \"tipoUsuario\": \"CLIENTE\",\n  \"endereco\": {\n    \"rua\": \"Rua das Flores\",\n    \"numero\": \"123\",\n    \"cidade\": \"São Paulo\",\n    \"cep\": \"01001-000\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "usuarios"]
            }
          }
        },
        {
          "name": "Cadastro inválido - e-mail duplicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Retorna detalhe do erro (ProblemDetail)\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.detail).to.include(\"E-mail já cadastrado\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Duplicado\",\n  \"email\": \"joao.silva@email.com\",\n  \"login\": \"joaosilva2\",\n  \"senha\": \"senha123\",\n  \"tipoUsuario\": \"CLIENTE\",\n  \"endereco\": {\n    \"rua\": \"Rua das Flores\",\n    \"numero\": \"123\",\n    \"cidade\": \"São Paulo\",\n    \"cep\": \"01001-000\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "usuarios"]
            }
          }
        },
        {
          "name": "Cadastro inválido - campos obrigatórios faltando",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Retorna campos com erro de validação\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.campos).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"\",\n  \"email\": \"email-invalido\",\n  \"login\": \"\",\n  \"senha\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "usuarios"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Autenticação",
      "item": [
        {
          "name": "Login válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Retorna token JWT\", function () {",
                  "    pm.expect(jsonData.token).to.not.be.undefined;",
                  "});",
                  "",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"joaosilva\",\n  \"senha\": \"senha123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Login inválido - credenciais erradas",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"joaosilva\",\n  \"senha\": \"senhaErrada\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Busca de Usuários",
      "item": [
        {
          "name": "Buscar usuário por nome",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Retorna lista de usuários\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios?nome=João",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "usuarios"],
              "query": [{ "key": "nome", "value": "João" }]
            }
          }
        },
        {
          "name": "Buscar usuário por id",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "usuarios", "{{usuarioId}}"]
            }
          }
        },
        {
          "name": "Buscar usuários sem token (erro)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios?nome=João",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "usuarios"],
              "query": [{ "key": "nome", "value": "João" }]
            }
          }
        }
      ]
    },
    {
      "name": "4. Atualização de Dados",
      "item": [
        {
          "name": "Atualizar dados com sucesso",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João Silva Santos\",\n  \"email\": \"joao.silva@email.com\",\n  \"login\": \"joaosilva\",\n  \"endereco\": {\n    \"rua\": \"Rua Nova\",\n    \"numero\": \"456\",\n    \"cidade\": \"São Paulo\",\n    \"cep\": \"01002-000\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "usuarios", "{{usuarioId}}"]
            }
          }
        },
        {
          "name": "Atualizar dados - usuário inexistente (erro)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuário Fantasma\",\n  \"email\": \"fantasma@email.com\",\n  \"login\": \"fantasma\",\n  \"endereco\": {\n    \"rua\": \"Rua X\",\n    \"numero\": \"0\",\n    \"cidade\": \"Nenhuma\",\n    \"cep\": \"00000-000\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "usuarios", "999999"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Troca de Senha",
      "item": [
        {
          "name": "Trocar senha com sucesso",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 204 No Content\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senhaAtual\": \"senha123\",\n  \"novaSenha\": \"novaSenha456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}/senha",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "usuarios", "{{usuarioId}}", "senha"]
            }
          }
        },
        {
          "name": "Trocar senha - senha atual incorreta (erro)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senhaAtual\": \"senhaErrada\",\n  \"novaSenha\": \"outraSenha789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}/senha",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "usuarios", "{{usuarioId}}", "senha"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Exclusão de Usuário",
      "item": [
        {
          "name": "Excluir usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 204 No Content\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "usuarios", "{{usuarioId}}"]
            }
          }
        },
        {
          "name": "Excluir usuário - já excluído / inexistente (erro)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios/{{usuarioId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "usuarios", "{{usuarioId}}"]
            }
          }
        }
      ]
    }
  ]
}
